# Edgeware — Environment Variables
# Copy this file to .env and fill in your values

# Anthropic API key for Claude thesis generation (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# EDGAR contact info for SEC rate-limit compliance (recommended)
EDGAR_USER_AGENT="Edgeware Stock Screener your_email@domain.com"

# Optional: override log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: override report output directory
REPORT_DIR=reports
